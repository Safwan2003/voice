# ============================================================================
# LOCAL TESTING — everything below works today on any machine, no GPU or
# office hardware needed. This is what start.sh reads by default.
# ============================================================================

# LiveKit server connection. Self-hosted (not LiveKit Cloud) — nobody
# issues these to you, you generate your own random pair:
#   livekit-server generate-keys
# If you don't have the livekit-server binary installed, start.sh will
# generate a real pair for you automatically (via Podman) the first time
# you run it, and save it back into this file.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME

# Tenant/persona data store — local JSON file, relative to the process's
# working directory (see docs/superpowers/specs/2026-07-08-multi-tenant-
# foundation-design.md). Works for both start.sh (run from voxreach-server/)
# and production (sdr-worker@.service sets WorkingDirectory=/opt/sdr-agent).
TENANTS_DATA_PATH=data/tenants.json

# Worker scaling and backpressure — sane defaults for local testing
OFFICE_NUM_WORKERS=1
OFFICE_LOAD_THRESHOLD=0.8

# LLM serving (vLLM) — model choice and base URL are fine as defaults;
# actually *running* vLLM still needs a GPU (see Capacity Analysis in
# docs/superpowers/specs/2026-07-07-office-server-deployment-design.md
# for why 3B is the day-one default on a shared 12GB card)
OFFICE_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct-AWQ
OFFICE_VLLM_BASE_URL=http://localhost:8000/v1

# ============================================================================
# OFFICE HARDWARE ONLY — fill these in once real GPU hardware exists.
# Unused by start.sh's local-dev mode; only matter for the systemd/production
# deployment path (see ../../README.md "Deploy to production").
# ============================================================================

# vLLM's GPU memory budget — tune once the actual GPU/VRAM is known
OFFICE_VLLM_GPU_MEM_UTIL=0.6

# STT (faster-whisper) — device/precision for the real GPU. Can be
# overridden to WHISPER_DEVICE=cpu for testing the code path locally
# (correctness only — far too slow for a real conversation)
WHISPER_MODEL_SIZE=large-v3-turbo
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_DEVICE=cuda

# TTS (OmniVoice) — device for the real GPU
OMNIVOICE_MODEL_ID=k2-fsa/OmniVoice
OMNIVOICE_DEVICE=cuda:0

# livekit-server TLS — real domain with valid certs at
# /etc/letsencrypt/live/$OFFICE_DOMAIN/ (see livekit-server.yaml.template).
# Production only — start.sh's local mode uses ws:// with no TLS at all.
OFFICE_DOMAIN=voice.example-office.com
