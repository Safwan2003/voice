# ============================================================================
# LOCAL TESTING — everything below works today on any machine, no GPU or
# office hardware needed. This is what deploy/container/run-local.sh reads by default.
# ============================================================================

# LiveKit server connection. Self-hosted (not LiveKit Cloud) — nobody
# issues these to you, you generate your own random pair:
#   livekit-server generate-keys
# If you don't have the livekit-server binary installed, deploy/container/run-local.sh will
# generate a real pair for you automatically (via Podman) the first time
# you run it, and save it back into this file.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME

# Tenant/persona data store — local JSON file, relative to the process's
# working directory (see docs/superpowers/specs/2026-07-08-multi-tenant-
# foundation-design.md). Works for both deploy/container/run-local.sh (run from voxreach-server/)
# and production (the worker container's WORKDIR is /opt/sdr-agent, set in worker.Containerfile).
TENANTS_DATA_PATH=data/tenants.json

# Worker scaling and backpressure — sane defaults for local testing
OFFICE_NUM_WORKERS=1
OFFICE_LOAD_THRESHOLD=0.8

# UI + self-service token endpoint (deploy/container/ui.Containerfile).
# UI_ACCESS_SECRET gates POST /api/token - anyone who knows this secret
# can get a working LiveKit connection token, so treat it like a
# password. run-local.sh auto-generates one if left as CHANGE_ME.
UI_PORT=8080
UI_ACCESS_SECRET=CHANGE_ME

# LLM provider — a hosted API, no GPU or local process needed. Defaults
# to Groq's free tier. Get a key at https://console.groq.com/keys.
#
# Swap providers later by changing OFFICE_LLM_PROVIDER + the matching
# *_API_KEY — no code changes:
#   groq      (default) — GROQ_API_KEY,      model default: llama-3.3-70b-versatile
#   openai               — OPENAI_API_KEY,    model default: gpt-4o-mini
#   anthropic             — ANTHROPIC_API_KEY, model default: claude-haiku-4-5
#                           (needs `pip install -e ".[anthropic]"`)
OFFICE_LLM_PROVIDER=groq
GROQ_API_KEY=CHANGE_ME
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Override the provider's default model (any provider):
OFFICE_LLM_MODEL=

# ============================================================================
# OFFICE HARDWARE ONLY — fill these in once real GPU hardware exists.
# Unused by deploy/container/run-local.sh's local-dev mode; only matter for the systemd/production
# deployment path (see ../../README.md "Deploy to production"). These are
# for STT/TTS, which run in-process in the worker and need a real GPU —
# the LLM (above) does not.
# ============================================================================

# STT (faster-whisper) — device/precision for the real GPU. Can be
# overridden to WHISPER_DEVICE=cpu for testing the code path locally
# (correctness only — far too slow for a real conversation)
WHISPER_MODEL_SIZE=large-v3-turbo
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_DEVICE=cuda

# TTS (OmniVoice) — device for the real GPU
OMNIVOICE_MODEL_ID=k2-fsa/OmniVoice
OMNIVOICE_DEVICE=cuda:0

# Unused when deploying behind Cloudflare Tunnel (see below) - Cloudflare
# terminates TLS at the edge, so livekit-server never holds its own
# certificate. Kept only in case a future deployment mode needs direct
# TLS again.
OFFICE_DOMAIN=voice.example-office.com

# ============================================================================
# CLOUDFLARE TUNNEL DEPLOYMENT — required if the office server has no
# forwarded UDP path and Cloudflare Tunnel is the only inbound route (see
# ../../README.md "Deploy behind Cloudflare Tunnel"). WebRTC call media
# needs a real public IP somewhere; since the office network can't provide
# one, these point livekit-server at an external TURN relay (a small VPS
# running coturn) instead.
# ============================================================================

# Hostname of the external TURN relay (the VPS running coturn) — NOT the
# office server itself.
LIVEKIT_TURN_HOST=turn.example-office.com
# Static long-lived credential pair configured in coturn's turnserver.conf
# (see deploy/turn/turnserver.conf.example). Treat like a password.
LIVEKIT_TURN_USERNAME=CHANGE_ME
LIVEKIT_TURN_CREDENTIAL=CHANGE_ME
