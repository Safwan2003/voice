[Unit]
Description=SDR voice agent worker (%i)
# LLM provider is config-driven (OFFICE_LLM_PROVIDER in office.env) — a
# hosted API (groq/openai/anthropic), so no local LLM process/ordering
# dependency is needed here.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/sdr-agent
EnvironmentFile=/etc/sdr-agent/office.env
ExecStart=/opt/sdr-agent/venv/bin/python -m sdr_agent.worker
Restart=on-failure
RestartSec=5
User=sdr-agent

[Install]
WantedBy=multi-user.target
